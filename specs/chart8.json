{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 300,
  "data": {
    "url": "data/dcceew_harvest_intensity_2021_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "HarvestPctQuota": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "format(datum.HarvestPctQuota, '.1f') + '%'",
      "as": "HarvestLabel"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 5,
        "stroke": "#fbf9f4",
        "strokeWidth": 5
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "sort": [
            2021,
            2022,
            2023,
            2024
          ],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelPadding": 10,
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "StateCode",
          "type": "nominal",
          "sort": [
            "NSW",
            "QLD",
            "SA",
            "VIC",
            "WA"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelPadding": 12,
            "ticks": false,
            "domain": false
          }
        },
        "color": {
          "field": "HarvestPctQuota",
          "type": "quantitative",
          "title": "Harvest as % of sustainable quota",
          "scale": {
            "domain": [
              0,
              80
            ],
            "range": [
              "#eee9df",
              "#6f4f3e"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 300,
            "gradientThickness": 13,
            "titleFont": "Arial",
            "labelFont": "Arial",
            "titleFontSize": 11,
            "labelFontSize": 10,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "HarvestPctQuota",
            "type": "quantitative",
            "title": "Harvest / sustainable quota",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 15,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "sort": [
            2021,
            2022,
            2023,
            2024
          ]
        },
        "y": {
          "field": "StateCode",
          "type": "nominal",
          "sort": [
            "NSW",
            "QLD",
            "SA",
            "VIC",
            "WA"
          ]
        },
        "text": {
          "field": "HarvestLabel",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.HarvestPctQuota >= 45",
            "value": "#ffffff"
          },
          "value": "#403b35"
        }
      }
    }
  ],
  "config": {
    "background": "#fbf9f4",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#222222",
      "titleColor": "#222222",
      "grid": false
    }
  }
}