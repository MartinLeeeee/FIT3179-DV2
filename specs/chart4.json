{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "data/kangaroo_wallaby_state_year_2021_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Observations": "number"
      }
    }
  },

  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Observations",
          "as": "TotalObservations"
        }
      ],
      "groupby": [
        "Year",
        "State",
        "StateCode"
      ]
    }
  ],

  "facet": {
    "field": "StateCode",
    "type": "nominal",

    "sort": [
      "NSW",
      "VIC",
      "QLD",
      "WA",
      "SA",
      "TAS",
      "ACT",
      "NT"
    ],

    "title": null,

    "header": {
      "labelFont": "Arial",
      "labelFontSize": 17,
      "labelFontWeight": "bold",
      "labelColor": "#222222",
      "labelPadding": 10
    }
  },

  "columns": 4,

  "spec": {
    "width": 220,
    "height": 170,

    "layer": [
      {
        "mark": {
          "type": "line",
          "strokeWidth": 3,
          "color": "#477b78"
        },

        "encoding": {
          "x": {
            "field": "Year",
            "type": "ordinal",

            "sort": [
              2021,
              2022,
              2023,
              2024,
              2025
            ],

            "title": null,

            "axis": {
              "labelAngle": 0,
              "labelFont": "Arial",
              "labelFontSize": 10,
              "labelColor": "#222222",
              "labelPadding": 6,

              "domain": false,
              "ticks": false,
              "grid": false
            }
          },

          "y": {
            "field": "TotalObservations",
            "type": "quantitative",

            "title": "Observation records",

            "scale": {
              "domain": [
                0,
                35000
              ],
              "nice": false
            },

            "axis": {
              "values": [
                0,
                5000,
                10000,
                15000,
                20000,
                25000,
                30000,
                35000
              ],

              "labelExpr": "datum.value == 0 ? '0k' : format(datum.value / 1000, '.0f') + 'k'",

              "grid": true,
              "gridColor": "#ded8cc",
              "gridOpacity": 0.85,

              "domain": false,
              "ticks": false,

              "labelFont": "Arial",
              "labelFontSize": 10,
              "labelColor": "#222222",

              "titleFont": "Arial",
              "titleFontSize": 11,
              "titleFontWeight": "bold",
              "titleColor": "#222222",
              "titlePadding": 8
            }
          },

          "order": {
            "field": "Year",
            "type": "quantitative"
          },

          "tooltip": [
            {
              "field": "State",
              "type": "nominal",
              "title": "State"
            },
            {
              "field": "Year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "TotalObservations",
              "type": "quantitative",
              "title": "Observation records",
              "format": ","
            }
          ]
        }
      },

      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 75,
          "color": "#477b78",
          "opacity": 0.85,
          "stroke": "#fbf9f4",
          "strokeWidth": 1.5
        },

        "encoding": {
          "x": {
            "field": "Year",
            "type": "ordinal",

            "sort": [
              2021,
              2022,
              2023,
              2024,
              2025
            ]
          },

          "y": {
            "field": "TotalObservations",
            "type": "quantitative",

            "scale": {
              "domain": [
                0,
                35000
              ],
              "nice": false
            }
          },

          "tooltip": [
            {
              "field": "State",
              "type": "nominal",
              "title": "State"
            },
            {
              "field": "Year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "TotalObservations",
              "type": "quantitative",
              "title": "Observation records",
              "format": ","
            }
          ]
        }
      }
    ]
  },

  "resolve": {
    "scale": {
      "x": "independent",
      "y": "shared"
    }
  },

  "spacing": 28,

  "config": {
    "background": "#fbf9f4",

    "view": {
      "stroke": null
    },

    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#222222",
      "titleColor": "#222222"
    }
  }
}