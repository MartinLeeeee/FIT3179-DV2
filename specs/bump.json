{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 880,
  "height": 420,

  "data": {
    "url": "data/kangaroo_wallaby_state_year_2021_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Observations": "number"
      }
    }
  },

  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Observations",
          "as": "TotalObservations"
        }
      ],
      "groupby": [
        "Year",
        "Species"
      ]
    },

    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],

      "sort": [
        {
          "field": "TotalObservations",
          "order": "descending"
        }
      ],

      "groupby": [
        "Year"
      ]
    }
  ],

  "layer": [

    {
      "mark": {
        "type": "line",
        "strokeWidth": 4,
        "opacity": 0.85
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative",

          "scale": {
            "domain": [
              2020.7,
              2026.2
            ]
          },

          "axis": {
            "title": null,

            "values": [
              2021,
              2022,
              2023,
              2024,
              2025
            ],

            "format": "d",

            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelPadding": 10,

            "grid": false
          }
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [
              6,
              1
            ]
          },

          "axis": {
            "title": "National rank",

            "values": [
              1,
              2,
              3,
              4,
              5,
              6
            ],

            "labelExpr": "'#' + datum.value",

            "labelFontSize": 12,
            "titleFontSize": 12,

            "grid": true,
            "gridColor": "#e5e0d7",
            "gridOpacity": 0.85
          }
        },

        "color": {
          "field": "Species",
          "type": "nominal",

          "scale": {
            "domain": [
              "Red Kangaroo",
              "Eastern Grey Kangaroo",
              "Western Grey Kangaroo",
              "Common Wallaroo",
              "Swamp Wallaby",
              "Red-necked Wallaby"
            ],

            "range": [
              "#b55232",
              "#657b62",
              "#c99545",
              "#81664d",
              "#477b78",
              "#8d6679"
            ]
          },

          "legend": null
        },

        "detail": {
          "field": "Species"
        },

        "tooltip": [
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },

          {
            "field": "Species",
            "type": "nominal",
            "title": "Species"
          },

          {
            "field": "Rank",
            "type": "quantitative",
            "title": "National rank"
          },

          {
            "field": "TotalObservations",
            "type": "quantitative",
            "title": "Observation records",
            "format": ","
          }
        ]
      }
    },


    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "stroke": "#fbf9f4",
        "strokeWidth": 2
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative",

          "scale": {
            "domain": [
              2020.7,
              2026.2
            ]
          }
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [
              6,
              1
            ]
          }
        },

        "color": {
          "field": "Species",
          "type": "nominal",

          "scale": {
            "domain": [
              "Red Kangaroo",
              "Eastern Grey Kangaroo",
              "Western Grey Kangaroo",
              "Common Wallaroo",
              "Swamp Wallaby",
              "Red-necked Wallaby"
            ],

            "range": [
              "#b55232",
              "#657b62",
              "#c99545",
              "#81664d",
              "#477b78",
              "#8d6679"
            ]
          },

          "legend": null
        },

        "tooltip": [
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },

          {
            "field": "Species",
            "type": "nominal",
            "title": "Species"
          },

          {
            "field": "Rank",
            "type": "quantitative",
            "title": "National rank"
          },

          {
            "field": "TotalObservations",
            "type": "quantitative",
            "title": "Observation records",
            "format": ","
          }
        ]
      }
    },


    {
      "transform": [
        {
          "filter": "datum.Year === 2025"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "fontSize": 11,
        "fontWeight": "bold"
      },

      "encoding": {

        "x": {
          "field": "Year",
          "type": "quantitative",

          "scale": {
            "domain": [
              2020.7,
              2026.2
            ]
          }
        },

        "y": {
          "field": "Rank",
          "type": "quantitative",

          "scale": {
            "domain": [
              6,
              1
            ]
          }
        },

        "text": {
          "field": "Species",
          "type": "nominal"
        },

        "color": {
          "field": "Species",
          "type": "nominal",

          "scale": {
            "domain": [
              "Red Kangaroo",
              "Eastern Grey Kangaroo",
              "Western Grey Kangaroo",
              "Common Wallaroo",
              "Swamp Wallaby",
              "Red-necked Wallaby"
            ],

            "range": [
              "#b55232",
              "#657b62",
              "#c99545",
              "#81664d",
              "#477b78",
              "#8d6679"
            ]
          },

          "legend": null
        }
      }
    }

  ],

  "config": {

    "background": "#fbf9f4",

    "view": {
      "stroke": null
    },

    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#222222",
      "titleColor": "#222222"
    }

  }
}