{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "data/kangaroo_wallaby_state_year_2021_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Observations": "number"
      }
    }
  },

  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Observations",
          "as": "SpeciesStateObservations"
        }
      ],
      "groupby": ["Species", "State"]
    },

    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "SpeciesStateObservations",
          "as": "SpeciesTotal"
        }
      ],
      "groupby": ["Species"]
    },

    {
      "calculate": "datum.SpeciesStateObservations / datum.SpeciesTotal",
      "as": "Share"
    },

    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "data/states_cw.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
        "key": "properties.STATE_NAME"
      },
      "as": "geo"
    }
  ],

  "facet": {
    "field": "Species",
    "type": "nominal",
    "sort": [
      "Red Kangaroo",
      "Eastern Grey Kangaroo",
      "Western Grey Kangaroo",
      "Common Wallaroo",
      "Swamp Wallaby",
      "Red-necked Wallaby"
    ],
    "title": null,
    "header": {
      "labelFont": "Arial",
      "labelFontSize": 15,
      "labelFontWeight": "bold",
      "labelColor": "#222222",
      "labelPadding": 12
    }
  },

  "columns": 3,

  "spec": {
    "width": 280,
    "height": 230,

    "projection": {
      "type": "mercator",
      "center": [134, -28],
      "scale": 310,
      "translate": [140, 115]
    },

    "layer": [
      {
        "data": {
          "url": "data/states_cw.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
        "mark": {
          "type": "geoshape",
          "fill": "#e7e4dd",
          "stroke": "#ffffff",
          "strokeWidth": 1.5
        }
      },

      {
        "mark": {
          "type": "geoshape",
          "stroke": "#ffffff",
          "strokeWidth": 1.5
        },
        "encoding": {
          "shape": {
            "field": "geo",
            "type": "geojson"
          },
          "color": {
            "field": "Share",
            "type": "quantitative",
            "title": "Share of species records",
            "scale": {
              "domain": [0, 0.8],
              "range": ["#edf2ef", "#477b78"],
              "clamp": true
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "title": "Share of species records",
              "format": ".0%",
              "values": [0, 0.2, 0.4, 0.6, 0.8],
              "gradientLength": 240,
              "gradientThickness": 12,
              "titleFont": "Arial",
              "labelFont": "Arial",
              "titleFontSize": 11,
              "labelFontSize": 10,
              "titleColor": "#333333",
              "labelColor": "#55514a"
            }
          },
          "tooltip": [
            {"field": "Species", "type": "nominal", "title": "Species"},
            {"field": "State", "type": "nominal", "title": "State"},
            {
              "field": "SpeciesStateObservations",
              "type": "quantitative",
              "title": "Observation records",
              "format": ","
            },
            {
              "field": "Share",
              "type": "quantitative",
              "title": "Share of species records",
              "format": ".1%"
            }
          ]
        }
      }
    ]
  },

  "resolve": {
    "scale": {"color": "shared"}
  },

  "spacing": 30,

  "config": {
    "background": "#fbf9f4",
    "view": {"stroke": null},
    "legend": {
      "labelColor": "#55514a",
      "titleColor": "#222222",
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}