{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "data/dcceew_population_2020_2023.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Population": "number"
      }
    }
  },

  "transform": [
    {
      "calculate": "format(datum.Population / 1000000, '.2f') + 'M'",
      "as": "PopulationLabel"
    }
  ],

  "facet": {
    "field": "StateCode",
    "type": "nominal",

    "sort": [
      "NSW",
      "QLD",
      "SA",
      "VIC",
      "WA"
    ],

    "title": null,

    "header": {
      "labelFont": "Arial",
      "labelFontSize": 16,
      "labelFontWeight": "bold",
      "labelColor": "#222222",
      "labelPadding": 12
    }
  },

  "columns": 3,

  "spec": {
    "width": 250,
    "height": 210,

    "layer": [

      {
        "mark": {
          "type": "line",
          "strokeWidth": 3,
          "color": "#657b62"
        },

        "encoding": {

          "x": {
            "field": "Year",
            "type": "ordinal",
            "title": null,

            "sort": [
              2020,
              2021,
              2022,
              2023
            ],

            "axis": {
              "labelAngle": 0,
              "labelFont": "Arial",
              "labelFontSize": 10,
              "labelColor": "#222222",
              "domain": false,
              "ticks": false,
              "grid": false
            }
          },

          "y": {
            "field": "Population",
            "type": "quantitative",

            "title": "Estimated population",

            "scale": {
              "domain": [
                0,
                20000000
              ],
              "nice": false
            },

            "axis": {
              "values": [
                0,
                5000000,
                10000000,
                15000000,
                20000000
              ],

              "labelExpr": "datum.value == 0 ? '0M' : format(datum.value / 1000000, '.0f') + 'M'",

              "grid": true,
              "gridColor": "#e4ded3",
              "gridOpacity": 0.8,

              "domain": false,
              "ticks": false,

              "labelFont": "Arial",
              "labelFontSize": 10,
              "labelColor": "#222222",

              "titleFont": "Arial",
              "titleFontSize": 11,
              "titleColor": "#222222",
              "titlePadding": 8
            }
          },

          "order": {
            "field": "Year",
            "type": "quantitative"
          },

          "tooltip": [
            {
              "field": "State",
              "type": "nominal",
              "title": "State"
            },
            {
              "field": "Year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "Population",
              "type": "quantitative",
              "title": "Estimated population",
              "format": ","
            }
          ]
        }
      },

      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 85,
          "color": "#657b62",
          "stroke": "#fbf9f4",
          "strokeWidth": 1.5
        },

        "encoding": {

          "x": {
            "field": "Year",
            "type": "ordinal",
            "sort": [
              2020,
              2021,
              2022,
              2023
            ]
          },

          "y": {
            "field": "Population",
            "type": "quantitative",

            "scale": {
              "domain": [
                0,
                20000000
              ],
              "nice": false
            }
          },

          "tooltip": [
            {
              "field": "State",
              "type": "nominal",
              "title": "State"
            },
            {
              "field": "Year",
              "type": "ordinal",
              "title": "Year"
            },
            {
              "field": "Population",
              "type": "quantitative",
              "title": "Estimated population",
              "format": ","
            }
          ]
        }
      },

      {
        "transform": [
          {
            "filter": "datum.Year == 2023"
          }
        ],

        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 8,
          "dy": -7,
          "font": "Arial",
          "fontSize": 10,
          "fontWeight": "bold",
          "color": "#55514a"
        },

        "encoding": {

          "x": {
            "field": "Year",
            "type": "ordinal",
            "sort": [
              2020,
              2021,
              2022,
              2023
            ]
          },

          "y": {
            "field": "Population",
            "type": "quantitative",

            "scale": {
              "domain": [
                0,
                20000000
              ],
              "nice": false
            }
          },

          "text": {
            "field": "PopulationLabel",
            "type": "nominal"
          }
        }
      }

    ]
  },

  "resolve": {
    "scale": {
      "x": "independent",
      "y": "shared"
    }
  },

  "spacing": 30,

  "config": {

    "background": "#fbf9f4",

    "view": {
      "stroke": null
    },

    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Arial",
      "titleFont": "Arial"
    }

  }
}