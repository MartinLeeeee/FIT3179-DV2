            "text": "NSW/ACT",
            "anchor": "middle",
            "fontSize": 16,
            "fontWeight": "bold",
            "offset": 10
          },

          "transform": [
            {
              "filter": "datum.Region === 'NSW/ACT'"
            }
          ],

          "layer": [

            {
              "transform": [
                {
                  "regression": "Observations",
                  "on": "Rainfall_mm"
                }
              ],

              "mark": {
                "type": "line",
                "color": "#b7ab98",
                "strokeWidth": 2.5,
                "strokeDash": [6, 5],
                "opacity": 0.8
              },

              "encoding": {
                "x": {
                  "field": "Rainfall_mm",
                  "type": "quantitative",
                  "scale": {
                    "domain": [0, 900]
                  }
                },

                "y": {
                  "field": "Observations",
                  "type": "quantitative"
                }
              }
            },

            {
              "mark": {
                "type": "point",
                "filled": true,
                "size": 110,
                "color": "#477b78",
