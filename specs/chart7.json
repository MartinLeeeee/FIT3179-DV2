{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 820,
  "height": 320,
  "data": {
    "url": "data/dcceew_quota_harvest_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "SustainableQuota": "number",
        "SpecialQuota": "number",
        "TotalHarvest": "number",
        "HarvestPctQuota": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.HarvestPctQuota / 100",
      "as": "HarvestShare"
    },
    {
      "calculate": "format(datum.HarvestPctQuota, '.1f') + '%'",
      "as": "HarvestLabel"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 34,
        "cornerRadiusEnd": 6,
        "color": "#e4e0d8"
      },
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "HarvestPctQuota",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labels": false,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "datum": 1,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": {
            "title": "Harvest as share of sustainable quota",
            "format": ".0%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "grid": true,
            "gridColor": "#e5e0d7",
            "gridOpacity": 0.8,
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        }
      }
    },

    {
      "mark": {
        "type": "bar",
        "size": 20,
        "cornerRadiusEnd": 5,
        "color": "#477b78"
      },
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "HarvestPctQuota",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "HarvestShare",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "SustainableQuota",
            "type": "quantitative",
            "title": "Sustainable quota",
            "format": ","
          },
          {
            "field": "TotalHarvest",
            "type": "quantitative",
            "title": "Reported harvest",
            "format": ","
          },
          {
            "field": "HarvestPctQuota",
            "type": "quantitative",
            "title": "Harvest / quota",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -12,
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#222222"
      },
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "HarvestPctQuota",
            "order": "descending"
          }
        },
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "text": {
          "field": "StateCode",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Overall": 0.268
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          6,
          4
        ],
        "strokeWidth": 2,
        "color": "#81664d"
      },
      "encoding": {
        "x": {
          "field": "Overall",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Overall": 0.268,
            "Label": "Five-state overall 26.8%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 7,
        "dy": -3,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#81664d"
      },
      "encoding": {
        "x": {
          "field": "Overall",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "Label"
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#33413a"
      },
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "sort": {
            "field": "HarvestPctQuota",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "HarvestShare",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "text": {
          "field": "HarvestLabel",
          "type": "nominal"
        }
      }
    }
  ],

  "padding": {
    "left": 70,
    "right": 30,
    "top": 10,
    "bottom": 10
  },

  "config": {
    "background": "#fbf9f4",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#222222",
      "titleColor": "#222222"
    }
  }
}